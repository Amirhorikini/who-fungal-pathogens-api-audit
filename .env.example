# Copy this file to .env (or export the variable in your shell) and fill it in
# with your own e-mail. .env is in .gitignore -- never commit the real one.

# E-mail sent in the User-Agent header of calls to public APIs (e.g.,
# OpenAlex), identifying who is making the request -- a practice recommended
# by the sources themselves for entry into "polite pools" with a higher rate
# limit. If not set, the tool uses a generic placeholder
# (your-email@example.org), which works but has no quota priority.
AUDIT_CONTACT_EMAIL=your-email@example.org
